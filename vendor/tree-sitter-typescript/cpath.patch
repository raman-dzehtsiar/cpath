+        if (lexer->lookahead != '/') return true;
+        advance(lexer);
+        if (lexer->lookahead == '/') {
+            while (lexer->lookahead && lexer->lookahead != '\n') advance(lexer);
+        } else if (lexer->lookahead == '*') {
+            advance(lexer);
+            bool closed = false;
+            while (lexer->lookahead) {
+                if (lexer->lookahead == '*') {
+                    advance(lexer);
+                    if (lexer->lookahead == '/') {
+                        advance(lexer);
+                        closed = true;
+                        break;
+                    }
